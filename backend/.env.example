# ============================================
# Email Campaign Management System
# Environment Configuration
# ============================================

# Application
NODE_ENV=development
PORT=5000
APP_NAME="Email Campaign Manager"
APP_URL=http://localhost:5173
API_URL=http://localhost:5000

# Database (MySQL)
DATABASE_URL="mysql://root:@localhost:3306/emailcampaign_db"

# JWT Authentication
JWT_ACCESS_SECRET=your-super-secret-access-key-change-in-production-min-32-chars
JWT_REFRESH_SECRET=your-super-secret-refresh-key-change-in-production-min-32-chars
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# Encryption (AES-256 for SMTP passwords)
ENCRYPTION_KEY=your-32-character-encryption-key!
ENCRYPTION_IV=your-16-char-iv!!

# CORS
CORS_ORIGIN=http://localhost:5173

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# File Uploads
MAX_FILE_SIZE=10485760
UPLOAD_DIR=./uploads

# Logging
LOG_LEVEL=dev

# Email Defaults
DEFAULT_FROM_EMAIL=noreply@example.com
DEFAULT_FROM_NAME="Email Campaign Manager"

# Campaign Defaults
DEFAULT_BATCH_SIZE=50
DEFAULT_DELAY_MS=1000
MAX_RETRY_ATTEMPTS=3
