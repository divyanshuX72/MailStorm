# ============================================
# Email Campaign Management System & Atreal CSO
# Environment Configuration Template
# ============================================

# Application Configuration
NODE_ENV=development
PORT=5000
APP_NAME="Email Campaign Manager"
APP_URL=http://localhost:5173
API_URL=http://localhost:5000

# Database Configuration (MySQL)
DATABASE_URL="mysql://root:@localhost:3306/emailcampaign_db"

# JWT Authentication (Replace with your secure 32+ char secrets)
JWT_ACCESS_SECRET=dev-access-secret-key-change-this-in-production-32chars
JWT_REFRESH_SECRET=dev-refresh-secret-key-change-this-in-production-32chars
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# Encryption Keys (AES-256 for SMTP Passwords)
# ENCRYPTION_KEY must be exactly 32 chars, ENCRYPTION_IV must be exactly 16 chars
ENCRYPTION_KEY=12345678901234567890123456789012
ENCRYPTION_IV=1234567890123456

# CORS & Security
CORS_ORIGIN=http://localhost:5173
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# File Uploads (Bytes: 10485760 = 10MB)
MAX_FILE_SIZE=10485760
UPLOAD_DIR=./uploads

# Logging
LOG_LEVEL=dev

# Campaign & Email Defaults
DEFAULT_FROM_EMAIL=noreply@example.com
DEFAULT_FROM_NAME="Email Campaign Manager"
DEFAULT_BATCH_SIZE=50
DEFAULT_DELAY_MS=1000
MAX_RETRY_ATTEMPTS=3

# OpenRouter AI Configuration (Optional / For AI Assistant & Agents)
OPENROUTER_API_KEY=your-openrouter-api-key-here
OPENROUTER_MODEL=openrouter/auto
